<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light"
    tools:context=".IniciarSessaoL1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header verde -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_header_rounded"
            android:paddingTop="56dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/logo2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_leaf"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="AgrIoT"
                android:textColor="@color/text_on_green"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtituloEstufa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Estufa Inteligente"
                android:textColor="@color/text_on_green_soft"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar Sessão"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtituloEntra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="20dp"
                android:text="Entra para gerir a sua estufa inteligente"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/idcliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID Cliente"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/insertidcliente"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center_vertical"
                android:hint="Ex.: 1024"
                android:inputType="number"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/palavrapass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Palavra-passe"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <EditText
                    android:id="@+id/insertpalavrapass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_field"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="10dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="44dp"
                    android:gravity="center_vertical"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/togglePassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_eye"
                    android:contentDescription="Mostrar palavra-passe" />
            </RelativeLayout>

            <Button
                android:id="@+id/entrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_green"
                android:text="ENTRAR"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:elevation="0dp" />

            <TextView
                android:id="@+id/Referencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Laboratório de Mecatrónica\nEstudo e Implementação de Uma Estufa Inteligente de Pequena Dimensão\nEduardo Junqueira · Pedro Pinto"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
